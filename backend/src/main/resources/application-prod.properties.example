# Copy to application-prod.properties and fill in. That file is gitignored.

spring.datasource.url=jdbc:mysql://localhost:3306/finappdb_prod?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
spring.datasource.username=CHANGE_ME
spring.datasource.password=CHANGE_ME

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

server.port=2003

# Must differ from the dev secret, and must not be a value that has ever been
# committed. Generate with: openssl rand -base64 32
jwt.secret=${JWT_SECRET:CHANGE_ME}

spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=CHANGE_ME@gmail.com
spring.mail.password=CHANGE_ME
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Required for password-reset links. This was missing before, so reset mail
# pointed nowhere under the prod profile.
app.frontend.url=http://localhost:5175
