# Copy to application-dev.properties and fill in. That file is gitignored.

spring.datasource.url=jdbc:mysql://localhost:3306/finappdb?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
spring.datasource.username=CHANGE_ME
spring.datasource.password=CHANGE_ME

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

server.port=2002

# Base64-encoded, at least 256 bits for HS256. Generate one with:
#   openssl rand -base64 32
# The env var wins, so it can be rotated without editing this file.
# Startup fails if this is unset — there is no fallback by design.
jwt.secret=${JWT_SECRET:CHANGE_ME}

# Gmail SMTP for password-reset mail. Use an App Password, not the account
# password: https://myaccount.google.com/apppasswords
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=CHANGE_ME@gmail.com
spring.mail.password=CHANGE_ME
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Where reset links point
app.frontend.url=http://localhost:5173
